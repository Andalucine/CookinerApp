# Copia este archivo como .env (nunca subas .env a GitHub)

# Base de datos PostgreSQL (los valores coinciden con docker-compose.yml)
POSTGRES_USER=cookiner
POSTGRES_PASSWORD=cookiner
POSTGRES_DB=cookinerapp
DATABASE_URL=postgresql+psycopg://cookiner:cookiner@db:5432/cookinerapp

# API
APP_ENV=development
SECRET_KEY=desarrollo-cambia-esta-clave-en-produccion-por-una-aleatoria-larga
DEFAULT_LANGUAGE=es
# Carpeta de las fotos hechas con el móvil (en Docker es ./uploads del proyecto)
UPLOADS_DIR=uploads
# Lo que se añade a cada enlace a Vinoselección para que la tienda sepa que la venta viene de
# CookinerApp (sesión 9). Cuando la tienda os dé vuestro código de agente, va aquí; por ejemplo:
# SHOP_LINK_PARAMS=utm_source=cookinerapp&utm_medium=app&utm_campaign=agente
SHOP_LINK_PARAMS=utm_source=cookinerapp&utm_medium=app
