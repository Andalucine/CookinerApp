{
  "expo": {
    "name": "CookinerApp",
    "slug": "cookinerapp",
    "scheme": "cookinerapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cookinerapp.app"
    },
    "android": {
      "package": "com.cookinerapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "CookinerApp usa tus fotos para poner una imagen a tus recetas, vinos y productos.",
          "cameraPermission": "CookinerApp usa la cámara para hacer fotos de tus recetas, vinos y productos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
